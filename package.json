{
  "name": "roguefus-lite",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\" \"outils/**/*.{js,mjs}\" index.html",
